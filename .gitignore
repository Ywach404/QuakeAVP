# Generated by XcodeGen -- project.yml is the source of truth
*.xcodeproj/
xcuserdata/
*.xcuserstate
.swiftpm/

# Build output
build/
DerivedData/
.hostbuild/

# Game data. Never commit these: id Software's paks are not redistributable.
# See LICENSE.txt and README.md.
*.pak
!App/Resources/quakespasm.pak
id1/
hipnotic/
rogue/

# macOS
.DS_Store

# range: generated from a local pak0; never commit id-derived data
*.bsp
*.wad
pak1.pak
pop.lmp

# Soundtrack audio. Never commit it: the music is not redistributable, same
# rule as the paks above.
#
# The CONTENTS are ignored rather than the directory, so the empty folder can
# be kept alive by its .gitkeep -- project.yml carries it into the bundle as a
# folder reference, and a folder reference to a path that does not exist is a
# hard build failure on a fresh clone. Same arrangement as App/DevGameData
# itself. Every real file in here is still ignored; do not relax this further.
App/DevGameData/music/*
!App/DevGameData/music/.gitkeep

# Session scratch: brainstorming mockups and round reports. Already in
# .git/info/exclude on this clone, which a fresh clone does not get.
.superpowers/
build-nosign/

# The in-headset console's Save button writes Documents/console.log on device
# (ContentView.swift), and pulling it off with devicectl lands it here under
# that same fixed name every time. It is a point-in-time diagnostic of one
# install -- it carries that install's container UUID and goes stale the moment
# the app is reinstalled -- so it is never the repo's to keep. Ignored rather
# than renamed so a saved log stays where the tooling already puts it.
console.log
